NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info
DATABASE_URL=postgresql://campus:replace-with-local-password@localhost:5432/smart_campus_lms
JWT_SECRET=replace-with-a-long-random-secret
PASSWORD_RESET_SECRET=replace-with-a-different-long-random-secret
PASSWORD_RESET_OTP_TTL_MINUTES=10
STUDENT_ENROLLMENT_PREFIX=SC
SUBMISSION_UPLOAD_DIR=var/private-uploads
# OTP request/verify/reset limits and five-failure lockout are enforced in code.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
CORS_ORIGIN=http://localhost:5173
